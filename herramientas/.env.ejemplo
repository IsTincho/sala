# Variables de las herramientas que corren en LA PC DEL DUEÑO.
#
# COPIA ESTE ARCHIVO A herramientas/.env. El .env de verdad esta
# ignorado por git.
#
# ESTO NO VA A RAILWAY. El token de R2 sirve para ESCRIBIR en el bucket
# y el servidor no sube nada: el video lo sube el dueño desde su casa
# con herramientas/subir.py, y el navegador lo lee directo de la URL
# publica. Si este token estuviera en Railway, una falla del servidor
# seria tambien una falla del bucket.
#
# Todo esto lo usa la Fase 2 (script de subida). En la Fase 0 el
# archivo existe para que los nombres esten decididos desde el dia uno.

# Cloudflare -> R2 -> Manage R2 API Tokens -> Create
# Permisos: Object Read & Write, solo sobre el bucket de Sala.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# El Account ID de Cloudflare (sale en el panel de R2).
# El endpoint S3 se arma solo: https://<account-id>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=

# Nombre del bucket.
R2_BUCKET=sala-video

# La URL publica del bucket (r2.dev). NO es secreta: es la que el
# navegador usa para pedir el video.
R2_URL_PUBLICA=

# A donde avisarle al servidor que hay un video nuevo.
SALA_URL=

# Clave de subida que se genera desde /panel. Autoriza al script a
# registrar videos en el servidor. No es el token de R2.
SALA_CLAVE_SUBIDA=
