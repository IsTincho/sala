node_modules/
*.log

# Secretos: cualquier archivo .env, se llame como se llame y este en la
# carpeta que este. Hacen falta los dos patrones: `*.env` cubre `.env` y
# `servidor/.env`, pero NO cubre `.env.local` ni `.env.produccion`,
# porque el comodin va antes del punto y no despues. Con `*.env` solo,
# esos dos se versionaban.
# Los .env.ejemplo si van al repo: no tienen ningun valor adentro.
*.env
*.env.*
!*.env.ejemplo

# datos de runtime del servidor en local, no codigo
servidor/datos/

# config local de herramientas
.claude/settings.local.json

# bytecode de python
__pycache__/

# Basura de las pruebas de herramientas/subir.py: ffmpeg deja segmentos e
# init sueltos donde se lo corra. Ningun video va al repo.
*.mp4
*.mkv
*.ts
*.m3u8
*.vtt
hls-*/
