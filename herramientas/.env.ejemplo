# Credenciales de la PC del dueño para subir video a Cloudflare R2.
#
# Copiá este archivo a herramientas/.env y completalo. `.env` está en
# .gitignore: nunca va al repo, nunca va a Railway, nunca se pega en el chat.
# subir.py no imprime ningún valor de acá.
#
#   cp herramientas/.env.ejemplo herramientas/.env
#
# Los tres primeros salen de Cloudflare → R2 → Manage R2 API Tokens → Create,
# con permisos Object Read & Write sobre el bucket sala-video (tarea 10 de
# TAREAS-DUENO.md). El Account ID está arriba a la derecha del panel de R2.

# Identificador de la cuenta de Cloudflare. Arma el endpoint del API S3:
# https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=

# Las dos claves del token de R2.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Nombre del bucket. Si no está, subir.py usa sala-video.
R2_BUCKET=sala-video

# URL pública del bucket, la del subdominio r2.dev (bucket → Settings →
# Public access). Es la que termina en el navegador de los espectadores, así
# que no es un secreto: también está anotada en TAREAS-DUENO.md.
# Ejemplo: https://pub-0123456789abcdef.r2.dev
R2_URL_PUBLICA=

# Dominio del servidor de Sala, para avisarle que el video existe.
# Ejemplo: https://sala-production.up.railway.app
URL_SERVIDOR=

# Clave de subida que genera el dueño en /panel. Es lo único que autoriza a
# dar de alta o borrar un video: tratala como una contraseña.
CLAVE_SUBIDA=

# Bajo qué prefijo del bucket va el video: <SALA_SLUG>/<id>/...
# Con un solo streamer es siempre istincho.
SALA_SLUG=istincho
