# Variables del servidor.
#
# COPIA ESTE ARCHIVO A servidor/.env PARA TRABAJAR EN LOCAL.
# El .env de verdad esta ignorado por git y no se sube nunca.
#
# En Railway estas mismas variables se cargan desde el dashboard del
# servicio (Variables), NUNCA desde un archivo ni desde la terminal:
# el dueño trabaja con la pantalla al aire.
#
# Los valores de aca abajo son de mentira. Ninguno es un secreto real.

# --------------------------------------------------------------- base

# El canal del dueño. Quien se loguee con Kick y tenga este slug es el dueño.
KICK_SLUG=istincho

# La URL publica del sitio. Tiene que coincidir EXACTAMENTE con el
# redirect registrado en la app de Kick y en la de Twitch.
URL_BASE=http://localhost:8778

# LOS OTROS dominios desde los que se sirve este MISMO sitio, separados
# por coma. Hoy: el proxy de Cloudflare Pages que esta delante de
# Railway (cloudflare/multichat/_worker.js). URL_BASE entra sola, no
# hace falta repetirla.
#
# Sirve para dos cosas que no pueden contradecirse:
#   - los POST del espectador exigen que el Origin sea uno de la lista;
#   - el login de OAuth vuelve al MISMO dominio donde empezo (si no, la
#     cookie queda en el otro y la persona vuelve sin sesion).
#
# OJO: un dominio aca tiene que estar TAMBIEN registrado como redirect
# en la app de Kick y en la de Twitch, o el login desde ahi rebota del
# lado de ellos. Sin esta variable todo sigue como antes: solo vale
# URL_BASE.
# ORIGENES=https://multichat-osmiumstudio.pages.dev

# local | produccion
#
# Ojo: MODO=local habilita /api/prueba/webhook, que inyecta eventos SIN
# verificar la firma. Sirve porque los webhooks de verdad no llegan a
# una maquina de casa. En Railway va MODO=produccion.
# Si la variable no esta, el servidor asume produccion.
MODO=local

# Puerto. En Railway lo pone la plataforma sola; no hace falta cargarlo.
PORT=8778

# ----------------------------------------------------------- secretos

# Clave de cifrado: 32 bytes al azar en base64. Cifra los refresh
# tokens guardados y firma las cookies de sesion.
#
# Para generarla sin que se vea en pantalla, en PowerShell:
#   node -e "process.stdout.write(require('crypto').randomBytes(32).toString('base64'))" | Set-Clipboard
# Queda en el portapapeles: pegala en Railway y listo.
#
# Si la cambias, se caen todas las sesiones y los tokens guardados
# dejan de poder descifrarse. No la cambies sin querer.
CLAVE_CIFRADO=

# App de Kick: kick.com -> Settings -> Developer (pide 2FA activo).
# Redirect URI: <URL_BASE>/oauth/kick/volver
# Ademas hay que prender "Enable Webhooks" y pegar <URL_BASE>/kick/webhook:
# esa URL NO se puede registrar por API, es a mano y una sola vez.
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# App de Twitch: dev.twitch.tv/console/apps
# OAuth Redirect URL: <URL_BASE>/oauth/twitch/volver
# Category: Website Integration. Client Type: Confidential.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# MongoDB Atlas. Si no esta, el servidor guarda en archivos JSON dentro
# de servidor/datos/ y lo avisa por consola. En local eso alcanza; en
# Railway el disco es efimero y se perderia todo en cada deploy.
MONGODB_URI=
MONGODB_DB=sala

# ============================================================
# Fase 3: otros creadores
# ============================================================

# --- R2, para firmar las subidas de cada creador -------------
#
# OJO: hasta la Fase 2 el token de R2 vivia SOLO en la PC del
# dueno (herramientas/.env). Desde que sube cualquier creador,
# no se le puede dar el token del bucket: con el leeria, pisaria
# y borraria los videos de todos. La forma de dar permiso
# acotado es una URL prefirmada, y firmar es tener el secreto.
#
# Conviene que este token sea OTRO, con permiso Object Read &
# Write sobre el bucket y nada mas. El video sigue sin pasar por
# Railway: se firma una URL y los gigas van directo a R2.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=sala-video
R2_URL_PUBLICA=https://pub-XXXXXXXX.r2.dev

# --- cobro ---------------------------------------------------
#
# COBRO_PROVEEDOR elige la implementacion. Hoy hay una: paddle.
# Para agregar Stripe: servidor/cobro-stripe.js con las mismas
# dos funciones, una linea en el registro de cobro.js, y aca
# COBRO_PROVEEDOR=stripe.
COBRO_PROVEEDOR=paddle

# sandbox por defecto: el descuido tiene que romper una prueba,
# no cobrar de verdad.
PADDLE_ENTORNO=sandbox
PADDLE_API_KEY=
PADDLE_PRECIO_ID=

# La clave secreta de la notificacion (empieza con pdl_ntfset_).
# Sin ella el plan NUNCA pasa a "pago": se cobra y no se habilita.
PADDLE_CLAVE_WEBHOOK=

# Cuanto desfase de reloj se tolera en la firma del webhook.
# Paddle documenta 5 s; aca el default son 60, porque todos los
# campos de un evento son absolutos y reprocesar uno repetido
# escribe lo mismo. Ver el encabezado de cobro-paddle.js.
# PADDLE_TOLERANCIA_S=60

# El precio que se MUESTRA en el panel. El que se cobra es el que
# este cargado en Paddle: son dos cosas y pueden desincronizarse.
PRECIO_MENSUAL=5
MONEDA=USD

# --- topes ---------------------------------------------------
#
# Canales con suscripcion de eventos. Kick admite 1.000 por app
# NO verificada; pasado eso el chat de los que entren queda mudo
# sin error visible. Pedirle a Kick la verificacion antes de 500.
# TOPE_CANALES=900

# Conexiones EventSub simultaneas que sostiene este proceso.
# Twitch permite 3 por (client id, user id), asi que una por
# creador es legal; lo que no escala es la RAM del contenedor.
# TOPE_TWITCH=50

# GB por plan. El bucket gratis son 10 GB EN TOTAL: la suma de lo
# que se reparte aca es lo que de verdad se puede regalar.
# GB_AMIGO=2
# GB_PAGO=5

# --- emotes de 7TV -------------------------------------------
#
# Los emotes de 7TV no vienen en el mensaje de Kick ni en el de
# Twitch: llegan como una palabra pelada y el servidor los
# resuelve contra el set de cada creador. Ver el README.

# Apagar 7TV entero, sin tocar codigo. Es un tercero: si un dia
# empieza a contestar cualquier cosa, el multichat tiene que
# poder seguir con los emotes nativos y nada mas.
# EMOTES_7TV=0

# Cuanto se esta dispuesto a gastar en UN emote, en KB. El emote
# se pide en 2x (64 px de alto), y si no entra, en 1x; si tampoco
# entra, la palabra queda como texto. Medido sobre un set real de
# 66 emotes: con 128 KB salen 56 en 2x, 7 en 1x y 3 no salen.
# Subirlo deja pasar animaciones de un mega, que se las baja el
# navegador de CADA espectador.
# EMOTES_KB=128

# Cuantos emotes de 7TV puede meter UN mensaje. El texto viene
# topeado en 2000 caracteres: sin esto, un solo mensaje de
# "CHAD CHAD CHAD..." son 400 imagenes en cada pestaña abierta.
# EMOTES_POR_MENSAJE=30
